# AI 服务配置（复制为 .env 后填写；不要把真实密钥提交到 Git）
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-5.6-luna

# 视频素材服务（可选；需要真实成片时填写）
MPT_PEXELS_API_KEY=

# 服务端口
BACKEND_PORT=8017

# 热点雷达超时（秒；0 表示不限时；也可在前端设置页修改）
NEWS_FETCH_TIMEOUT_SECONDS=90
MODEL_TIMEOUT_SECONDS=30
# 小红书热点数据（可选；从 https://redfox.hk/settings/api-keys 获取）
# REDFOX_API_KEY=

# 股票分析增强数据（可选）
# TUSHARE_TOKEN=
# TAVILY_API_KEY=
# SERPAPI_KEY=
