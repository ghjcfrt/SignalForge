# AI 服务配置（复制为 .env 后填写；不要把真实密钥提交到 Git）
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-5.6-luna

# 视频素材服务（可选；需要真实成片时填写）
MPT_PEXELS_API_KEY=

# 服务端口
BACKEND_PORT=8017

# 热点雷达超时（秒；0 表示不限时；也可在前端设置页修改）
NEWS_FETCH_TIMEOUT_SECONDS=90
MODEL_TIMEOUT_SECONDS=30
# 单次完整工作流总时限（秒；0 表示不限时；超时后保留检查点）
WORKFLOW_TIMEOUT_SECONDS=300

# 爆款分析的小红书样本（可选；从 https://socialdatax.com/dashboard/api-keys 获取）
# SOCIALDATAX_API_KEY=
# SOCIALDATAX_BASE_URL=https://mcp.socialdatax.com
# SOCIALDATAX_TIMEOUT_SECONDS=60

# 股票分析增强数据（可选）
# TUSHARE_TOKEN=
# TAVILY_API_KEY=
# SERPAPI_KEY=
