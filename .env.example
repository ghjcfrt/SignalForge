# 热讯工坊后端读取这个环境变量作为 OpenAI 兼容接口密钥。
# 不要把真实 key 提交到仓库。
OPENAI_API_KEY_YW_SF=

# 默认值已经写在代码里；如需覆盖可取消注释。
# OPENAI_BASE_URL_YW_SF=https://api.wlai.vip/v1
# OPENAI_MODEL_YW_SF=gpt-4o-mini

# MoneyPrinterTurbo 官方 Agent Skill 使用这些变量。
# MPT_LLM_PROVIDER=oneapi
# MPT_LLM_API_KEY=可以直接复用 OPENAI_API_KEY_YW_SF 的值
# MPT_LLM_BASE_URL=https://api.wlai.vip/v1
# MPT_LLM_MODEL_NAME=gpt-4o-mini
# MPT_PEXELS_API_KEY=

# 服务端口
BACKEND_PORT=8017
